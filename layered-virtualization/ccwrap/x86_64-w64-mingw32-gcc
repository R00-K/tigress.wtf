#!/bin/bash
# Project-local wrapper: injects -I<project>/compat ahead of the real
# x86_64-w64-mingw32-gcc so Tigress's preprocessing pass picks up the
# stub AVX-512 FP16/BF16 headers instead of GCC 13's real ones (which
# use _Float16 "0.0f16" literal syntax Tigress's parser rejects).
#
# The final MinGW build of the Tigress-generated output does NOT use
# this wrapper, so it gets the real, fully-correct system headers.
REAL=/usr/bin/x86_64-w64-mingw32-gcc
# Resolve the project directory from this script's own location so the
# wrapper keeps working if the project directory is renamed or moved.
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$REAL" -I"$PROJECT_DIR/compat" "$@"
